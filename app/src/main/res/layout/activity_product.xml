<?xml version="1.0" encoding="utf-8"?>
<!-- GemStore - Product Page (design 375 x 1818) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/gs_cream">

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="match_parent" android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== GALERIE ===== -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="390dp"
                android:background="@color/gs_cream">

                <View android:layout_width="220dp" android:layout_height="220dp"
                    android:layout_gravity="center" android:background="@drawable/bg_circle_peach" />

                <!-- IMG: poza produs (PNG fara fundal) -->
                <ImageView android:id="@+id/imgProduct" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/product_main" />

                <ImageView android:id="@+id/btnBack" android:layout_width="36dp" android:layout_height="36dp"
                    android:layout_gravity="top|start" android:layout_marginStart="32dp" android:layout_marginTop="68dp"
                    android:background="@drawable/bg_circle_white" android:elevation="3dp" android:padding="8dp"
                    android:src="@drawable/ic_back" />

                <ImageView android:id="@+id/btnFavorite" android:layout_width="36dp" android:layout_height="36dp"
                    android:layout_gravity="top|end" android:layout_marginTop="68dp" android:layout_marginEnd="32dp"
                    android:background="@drawable/bg_circle_white" android:elevation="3dp" android:padding="8dp"
                    android:src="@drawable/ic_heart" />

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="44dp"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <View android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/bg_circle_white"
                        android:elevation="2dp" />
                    <View android:layout_width="5dp" android:layout_height="5dp" android:layout_marginStart="7dp"
                        android:background="@drawable/bg_swatch_black" />
                    <View android:layout_width="5dp" android:layout_height="5dp" android:layout_marginStart="7dp"
                        android:background="@drawable/bg_swatch_black" />
                </LinearLayout>
            </FrameLayout>

            <!-- ===== DETALII (panou alb) ===== -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="-28dp" android:background="@drawable/bg_sheet"
                android:orientation="vertical" android:paddingHorizontal="32dp"
                android:paddingTop="40dp" android:paddingBottom="120dp">

                <!-- Nume + pret -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Sportwear Set" android:textColor="#000000" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="$ 80.00" android:textColor="#000000" android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_marginEnd="4dp" android:src="@drawable/ic_star" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_marginEnd="4dp" android:src="@drawable/ic_star" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_marginEnd="4dp" android:src="@drawable/ic_star" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_marginEnd="4dp" android:src="@drawable/ic_star" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:layout_marginEnd="4dp" android:src="@drawable/ic_star" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:text="(83)" android:textColor="@color/gs_gray" android:textSize="11sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp"
                    android:background="@color/gs_divider" />

                <!-- Culoare + Marime -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Color" android:textColor="@color/gs_gray" android:textSize="14sp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <FrameLayout android:id="@+id/colorPeach" android:layout_width="38dp" android:layout_height="38dp"
                                android:background="@drawable/bg_circle_white" android:elevation="4dp">
                                <View android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center"
                                    android:background="@drawable/bg_swatch_peach" />
                            </FrameLayout>
                            <View android:id="@+id/colorBlack" android:layout_width="26dp" android:layout_height="26dp"
                                android:layout_marginStart="14dp" android:background="@drawable/bg_swatch_black" />
                            <View android:id="@+id/colorCoral" android:layout_width="26dp" android:layout_height="26dp"
                                android:layout_marginStart="14dp" android:background="@drawable/bg_swatch_coral" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Size" android:textColor="@color/gs_gray" android:textSize="14sp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="-12dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                            <TextView android:id="@+id/sizeS" android:layout_width="32dp" android:layout_height="32dp"
                                android:layout_marginStart="12dp" android:background="@drawable/bg_size" android:gravity="center"
                                android:text="S" android:textColor="@color/gs_size_text" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/sizeM" android:layout_width="32dp" android:layout_height="32dp"
                                android:layout_marginStart="12dp" android:background="@drawable/bg_size" android:gravity="center"
                                android:text="M" android:textColor="@color/gs_size_text" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/sizeL" android:layout_width="32dp" android:layout_height="32dp"
                                android:layout_marginStart="12dp" android:background="@drawable/bg_size_selected" android:gravity="center"
                                android:text="L" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="22dp"
                    android:background="@color/gs_divider" />

                <!-- Description -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Description" android:textColor="#000000" android:textSize="17sp" android:textStyle="bold" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_down" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:lineSpacingExtra="4dp"
                    android:text="Sportswear is no longer under culture, it is no longer indie or cobbled together as it once was. Sport is fashion today. The top is oversized in fit and style, may need to size down." android:textColor="#222222" android:textSize="14sp" />
                <TextView android:id="@+id/btnReadMore" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Read more" android:textColor="@color/gs_green" android:textSize="14sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="22dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Reviews" android:textColor="#000000" android:textSize="17sp" android:textStyle="bold" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_down" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp"
                    android:background="@color/gs_divider" />

                <!-- Rating general -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="4.9" android:textColor="#000000" android:textSize="40sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="8dp" android:layout_marginTop="22dp"
                        android:text="OUT OF 5" android:textColor="@color/gs_gray" android:textSize="12sp" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:gravity="end" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_marginEnd="2dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_marginEnd="2dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_marginEnd="2dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_marginEnd="2dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                android:layout_marginEnd="2dp" android:src="@drawable/ic_star" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="83 ratings" android:textColor="#B5B5BE" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="12dp" android:layout_height="wrap_content" android:text="5"
                        android:textColor="@color/gs_gray" android:textSize="12sp" />
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:layout_marginStart="4dp"
                        android:src="@drawable/ic_star" />
                    <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp"
                        android:layout_height="4dp" android:layout_marginHorizontal="12dp" android:layout_weight="1"
                        android:max="100" android:progress="80" android:progressDrawable="@drawable/progress_rating" />
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:gravity="end"
                        android:text="80%" android:textColor="#333333" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="12dp" android:layout_height="wrap_content" android:text="4"
                        android:textColor="@color/gs_gray" android:textSize="12sp" />
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:layout_marginStart="4dp"
                        android:src="@drawable/ic_star" />
                    <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp"
                        android:layout_height="4dp" android:layout_marginHorizontal="12dp" android:layout_weight="1"
                        android:max="100" android:progress="12" android:progressDrawable="@drawable/progress_rating" />
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:gravity="end"
                        android:text="12%" android:textColor="#333333" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="12dp" android:layout_height="wrap_content" android:text="3"
                        android:textColor="@color/gs_gray" android:textSize="12sp" />
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:layout_marginStart="4dp"
                        android:src="@drawable/ic_star" />
                    <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp"
                        android:layout_height="4dp" android:layout_marginHorizontal="12dp" android:layout_weight="1"
                        android:max="100" android:progress="5" android:progressDrawable="@drawable/progress_rating" />
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:gravity="end"
                        android:text="5%" android:textColor="#333333" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="12dp" android:layout_height="wrap_content" android:text="2"
                        android:textColor="@color/gs_gray" android:textSize="12sp" />
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:layout_marginStart="4dp"
                        android:src="@drawable/ic_star" />
                    <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp"
                        android:layout_height="4dp" android:layout_marginHorizontal="12dp" android:layout_weight="1"
                        android:max="100" android:progress="3" android:progressDrawable="@drawable/progress_rating" />
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:gravity="end"
                        android:text="3%" android:textColor="#333333" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="12dp" android:layout_height="wrap_content" android:text="1"
                        android:textColor="@color/gs_gray" android:textSize="12sp" />
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:layout_marginStart="4dp"
                        android:src="@drawable/ic_star" />
                    <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp"
                        android:layout_height="4dp" android:layout_marginHorizontal="12dp" android:layout_weight="1"
                        android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_rating" />
                    <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:gravity="end"
                        android:text="0%" android:textColor="#333333" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="22dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="47 Reviews" android:textColor="#B5B5BE" android:textSize="12sp" />
                    <TextView android:id="@+id/btnWriteReview" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="WRITE A REVIEW" android:textColor="#9A9AA5" android:textSize="12sp" />
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp"
                        android:src="@drawable/ic_pencil" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="22dp" android:orientation="horizontal">
                    <!-- IMG: avatar Jennifer Rose -->
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_circle_avatar" android:scaleType="centerCrop" android:src="@drawable/avatar_jennifer" android:clipToOutline="true" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Jennifer Rose" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:orientation="horizontal">
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:layout_marginEnd="3dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:layout_marginEnd="3dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:layout_marginEnd="3dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:layout_marginEnd="3dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:layout_marginEnd="3dp" android:src="@drawable/ic_star" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="5m ago" android:textColor="#B5B5BE" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:lineSpacingExtra="3dp"
                    android:text="I love it.  Awesome customer service!! Helped me out with adding an additional item to my order. Thanks again!" android:textColor="#222222" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="26dp" android:orientation="horizontal">
                    <!-- IMG: avatar Kelly Rihana -->
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_circle_avatar" android:scaleType="centerCrop" android:src="@drawable/avatar_kelly" android:clipToOutline="true" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Kelly Rihana" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:orientation="horizontal">
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:layout_marginEnd="3dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:layout_marginEnd="3dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:layout_marginEnd="3dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:layout_marginEnd="3dp" android:src="@drawable/ic_star" />
                            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                android:layout_marginEnd="3dp" android:src="@drawable/ic_star" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="9m ago" android:textColor="#B5B5BE" android:textSize="12sp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:lineSpacingExtra="3dp"
                    android:text="I&apos;m very happy with order, It was delivered on and good quality. Recommended!" android:textColor="#222222" android:textSize="12sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="22dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Similar Product" android:textColor="#000000" android:textSize="17sp" android:textStyle="bold" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_down" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp"
                    android:background="@color/gs_divider" />

                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:clipToPadding="false" android:scrollbars="none">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="123dp" android:layout_height="wrap_content"
                            android:layout_marginStart="0dp" android:orientation="vertical">
                            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                                android:layout_height="160dp" app:cardBackgroundColor="@color/gs_bg_img"
                                app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                                <!-- IMG: Rise Crop Hoodie -->
                                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                                    android:scaleType="centerCrop" android:src="@drawable/similar_hoodie" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="12dp" android:text="Rise Crop Hoodie" android:textColor="#000000" android:textSize="13sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="$ 43.00" android:textColor="#000000"
                                android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="123dp" android:layout_height="wrap_content"
                            android:layout_marginStart="16dp" android:orientation="vertical">
                            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                                android:layout_height="160dp" app:cardBackgroundColor="@color/gs_bg_img"
                                app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                                <!-- IMG: Gym Crop Top -->
                                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                                    android:scaleType="centerCrop" android:src="@drawable/similar_croptop" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="12dp" android:text="Gym Crop Top" android:textColor="#000000" android:textSize="13sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="$ 39.99" android:textColor="#000000"
                                android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="123dp" android:layout_height="wrap_content"
                            android:layout_marginStart="16dp" android:orientation="vertical">
                            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                                android:layout_height="160dp" app:cardBackgroundColor="@color/gs_bg_img"
                                app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                                <!-- IMG: Sport Sweatshirt -->
                                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                                    android:scaleType="centerCrop" android:src="@drawable/similar_sweatshirt" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="12dp" android:text="Sport Sweatshirt" android:textColor="#000000" android:textSize="13sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="$ 47.99" android:textColor="#000000"
                                android:textSize="16sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== ADD TO CART (fix jos) ===== -->
    <FrameLayout android:id="@+id/btnAddToCart" android:layout_width="match_parent" android:layout_height="80dp"
        android:layout_gravity="bottom" android:layout_marginHorizontal="24dp" android:background="@drawable/bg_cart">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginBottom="6dp" android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_bag" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:text="Add To Cart" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>
        <View android:layout_width="100dp" android:layout_height="4dp" android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp" android:background="@drawable/bg_line" />
    </FrameLayout>
</FrameLayout>
